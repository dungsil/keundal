{
  "name": "@keundal/agent-host",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@keundal/agent": "workspace:*",
    "@keundal/core": "workspace:*",
    "@keundal/generation": "workspace:*",
    "@keundal/llm": "workspace:*",
    "@keundal/session": "workspace:*",
    "@keundal/skill": "workspace:*",
    "@keundal/task": "workspace:*",
    "@keundal/tool-approval": "workspace:*",
    "cordis": "catalog:"
  },
  "devDependencies": {
    "@keundal/plugin-agent-chat": "workspace:*",
    "@keundal/plugin-chat-local": "workspace:*",
    "@keundal/plugin-chat-remote": "workspace:*",
    "@keundal/plugin-store-memory": "workspace:*",
    "@keundal/task-memory": "workspace:*",
    "@keundal/trace": "workspace:*",
    "@keundal/tsconfig": "workspace:*",
    "@keundal/tsdown": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
