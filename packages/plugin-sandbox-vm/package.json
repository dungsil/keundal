{
  "name": "@keundal/plugin-sandbox-vm",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:image": "node scripts/build-image.mjs",
    "build:broker": "cargo build --release --locked --manifest-path file-broker/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@keundal/sandbox": "workspace:*"
  },
  "devDependencies": {
    "@keundal/tsconfig": "workspace:*",
    "@keundal/tsdown": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
