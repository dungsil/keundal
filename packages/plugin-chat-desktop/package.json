    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@keundal/chat": "workspace:*",
    "@keundal/plugin-chat-remote": "workspace:*"
  },
  "devDependencies": {
    "@keundal/tsconfig": "workspace:*",
    "@keundal/tsdown": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
