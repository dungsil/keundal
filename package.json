{
  "name": "keundal",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "dungsil (https://github.com/dungsil)",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:preview": "turbo run build:preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "pnpm check:boundaries && oxlint && oxfmt --check",
    "lintfix": "oxlint --fix && oxfmt",
    "prepare": "simple-git-hooks",
    "check:boundaries": "node tools/workspace-boundaries/check.mjs",
    "test:boundaries": "node --test tools/workspace-boundaries/tests/*.test.ts",
    "lighthouse:local": "pnpm dlx --allow-build=esbuild --allow-build=puppeteer --allow-build=vue-demi @unlighthouse/cli@0.19.1 --site http://localhost:3000 --config-file tools/lighthouse/unlighthouse.config.mjs"
  },
  "devDependencies": {
    "@keundal/tsconfig": "workspace:*",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.10.13",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
