#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
package_manager="$(node -p 'require("./package.json").packageManager')"
node_version="$(node -p 'require("./package.json").devEngines.runtime.version')"

echo 'Preparing the pinned pnpm and Node.js toolchain'
SECONDS=0
if [[ ! -x "$PNPM_HOME/bin/pnpm" ]] ||
  [[ "$("$PNPM_HOME/bin/pnpm" --version)" != "${package_manager#pnpm@}" ]]; then
  npm install --global --prefix "$PNPM_HOME" "$package_manager" --no-audit --no-fund
fi
if [[ "$(node --version)" != "v$node_version" ]]; then
  pnpm runtime set node "$node_version" --global
fi

# Login shells used by Amp and supervised services must use the same toolchain.
profile_marker='# Keundal orb toolchain'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Keundal orb toolchain
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
EOF
fi
echo "Toolchain ready in ${SECONDS}s: $(node --version), pnpm $(pnpm --version)"

echo 'Installing workspace dependencies from the lockfile'
SECONDS=0
pnpm install --frozen-lockfile
echo "Dependencies ready in ${SECONDS}s"

echo 'Preparing the Linux execution VM test assets'
SECONDS=0
missing=()
for package in qemu-system-x86 qemu-utils linux-image-cloud-amd64 cpio busybox-static e2fsprogs file gzip git; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
    missing+=("$package")
  fi
done
if (( ${#missing[@]} )); then
  sudo apt-get update
  sudo apt-get install --no-install-recommends -y "${missing[@]}"
fi
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v cargo >/dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
fi
cargo build --release --locked --manifest-path packages/plugin-sandbox-vm/file-broker/Cargo.toml
pnpm exec turbo run build --filter=@keundal/plugin-sandbox-vm
cache="$HOME/.cache/keundal/sandbox-vm"
mkdir -p "$cache"
image_key="$(cat packages/plugin-sandbox-vm/dist/guest/guest.js packages/plugin-sandbox-vm/scripts/build-image.mjs packages/plugin-sandbox-vm/image/* /boot/vmlinuz-* | sha256sum | cut -d' ' -f1)"
assets="$cache/$image_key"
if [[ ! -f "$assets/manifest.json" ]]; then
  rm -rf "$assets"
  pnpm --filter @keundal/plugin-sandbox-vm build:image --output "$assets" --guest dist/guest/guest.js
fi
rm -f "$cache/test-config.json"
node packages/plugin-sandbox-vm/scripts/configure-test.mjs "$assets" "$cache/test-config.json"
if ! grep -Fq '# Keundal VM test assets' "$HOME/.bash_profile"; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Keundal VM test assets
export KEUNDAL_TEST_VM_CONFIG="$HOME/.cache/keundal/sandbox-vm/test-config.json"
EOF
fi
echo "VM test assets ready in ${SECONDS}s"
