#!/usr/bin/env bash
set -euo pipefail

# Pin the bootstrap executable and the initial toolchain independently.
rustup_version=1.29.2
rust_version=1.99.1
case "$(uname -m)" in
  x86_64)
    target=x86_64-unknown-linux-gnu
    checksum=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
    ;;
  aarch64|arm64)
    target=aarch64-unknown-linux-gnu
    checksum=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
    ;;
  *)
    echo 'Install Rust manually on this unsupported architecture.' >&2
    exit 1
    ;;
esac

installer_dir=$(mktemp -d)
trap 'rm -rf "$installer_dir"' EXIT
installer="$installer_dir/rustup-init"
curl --proto '=https' --tlsv1.2 -fsSL \
  "https://static.rust-lang.org/rustup/archive/$rustup_version/$target/rustup-init" \
  -o "$installer"
printf '%s  %s\n' "$checksum" "$installer" | sha256sum --check --status
chmod 700 "$installer"
"$installer" -y --profile minimal --default-toolchain "$rust_version" --no-modify-path
