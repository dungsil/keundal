{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-sidecar/**"]
    },
    "@keundal/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "@keundal/web#build:cloudflare": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "@keundal/web#build:preview": {
      "dependsOn": ["build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "@keundal/desktop#build:preview": {
      "dependsOn": ["^build"],
      "env": [
        "RUNNER_OS",
        "RUNNER_ARCH",
        "RUSTC_VERSION",
        "RUSTUP_TOOLCHAIN",
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "CARGO_BUILD_TARGET",
        "APPLE_SIGNING_IDENTITY",
        "TAURI_ENV_TARGET_TRIPLE"
      ],
      "passThroughEnv": ["APPIMAGE_EXTRACT_AND_RUN", "CARGO_HOME", "CARGO_INCREMENTAL", "RUSTUP_HOME"],
      "outputs": [
        "dist/**",
        "src-tauri/target/release/bundle/**",
        "src-tauri/target/release/keundal-desktop.exe",
        "src-tauri/sidecar/**",
        "src-tauri/binaries/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "@keundal/web#typecheck": {
      "dependsOn": ["^build"]
    },
    "@keundal/desktop#build:sidecar": {
      "dependsOn": ["@keundal/agent-host#build"],
      "outputs": ["dist-sidecar/**"]
    },
    "@keundal/desktop#typecheck": {
      "dependsOn": ["build:sidecar"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@keundal/desktop#test": {
      "dependsOn": ["build:sidecar"]
    }
  }
}
