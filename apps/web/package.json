{
  "name": "@keundal/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset=cloudflare_module",
    "build:preview": "pnpm build:cloudflare",
    "deploy:cloudflare": "wrangler deploy --config .output/server/wrangler.json",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@keundal/chat-app": "workspace:*",
    "@keundal/agent-host": "workspace:*",
    "nuxt": "^4.6.2",
    "h3": "2.0.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1",
    "@keundal/core": "workspace:*",
    "@keundal/agent": "workspace:*",
    "@keundal/plugin-store-memory": "workspace:*",
    "cordis": "catalog:"
  }
}
