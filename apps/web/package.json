{
  "name": "@keundal/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset=cloudflare_module",
    "build:preview": "pnpm build:cloudflare",
    "deploy:cloudflare": "wrangler deploy --config .output/server/wrangler.json",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.test.json",
    "build:desktop": "nuxt generate --envName desktop"
  },
  "dependencies": {
    "@comark/nuxt": "^0.7.0",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@keundal/core": "workspace:*",
    "@keundal/ui": "workspace:*",
    "@keundal/agent": "workspace:*",
    "@keundal/plugin-llm-anthropic": "workspace:*",
    "@keundal/plugin-llm-gemini": "workspace:*",
    "@keundal/plugin-llm-openai": "workspace:*",
    "@keundal/plugin-skill": "workspace:*",
    "@keundal/plugin-skill-filesystem": "workspace:*",
    "@keundal/plugin-store-indexeddb": "workspace:*",
    "@keundal/plugin-transcription-openai": "workspace:*",
    "@nuxt/ui": "^4.11.3",
    "@shikijs/langs": "^4.5.0",
    "@tauri-apps/api": "2.12.4",
    "@vueuse/core": "^14.4.0",
    "cordis": "catalog:",
