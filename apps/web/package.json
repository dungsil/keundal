    "motion-v": "^2.6.0",
    "nuxt": "^4.6.2",
    "nuxt-charts": "^2.2.3",
    "shiki": "^4.5.0",
    "striptags": "3.2.0",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.44",
    "zod": "^4.6.5",
    "@keundal/agent-host": "workspace:*",
    "h3": "2.0.3"
  },
  "devDependencies": {
    "@keundal/plugin-store-memory": "workspace:*",
    "@keundal/plugin-store-sqlite": "workspace:*",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "fake-indexeddb": "6.2.6",
