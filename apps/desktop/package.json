{
  "name": "@keundal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:sidecar && pnpm build:ui",
    "build:preview": "pnpm bundle",
    "bundle": "tauri build",
    "dev": "pnpm prepare:sidecar && tauri dev",
    "dev:ui": "nuxt dev --no-open",
    "tauri": "tauri",
    "prepare:sidecar": "pnpm build:sidecar && node scripts/prepare-sidecar.mjs",
    "build:tauri": "pnpm exec turbo run build:sidecar build:ui --filter=@keundal/desktop && node scripts/prepare-sidecar.mjs",
    "build:sidecar": "tsdown --config tsdown.sidecar.config.ts",
    "build:native": "tauri build -- --locked",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.sidecar.json",
    "build:ui": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@keundal/agent-runtime-node": "workspace:*",
    "@keundal/browser-composition": "workspace:*",
    "@keundal/chat": "workspace:*",
    "@keundal/chat-app": "workspace:*",
    "@keundal/llm-settings": "workspace:*",
    "@keundal/mcp": "workspace:*",
    "@keundal/plugin-chat-browser": "workspace:*",
    "@keundal/plugin-chat-desktop": "workspace:*",
    "@keundal/plugin-llm-browser": "workspace:*",
    "@keundal/plugin-mcp-client": "workspace:*",
    "@keundal/plugin-runtime": "workspace:*",
    "@keundal/plugin-tool-chart": "workspace:*",
    "@keundal/plugin-tool-weather": "workspace:*",
    "@keundal/ui-workspace": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "cordis": "catalog:",
    "desktop-npm": "npm:npm@11.12.0",
    "fflate": "0.8.3",
    "import-meta-resolve": "4.2.0",
    "nuxt": "^4.6.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@keundal/agent-host": "workspace:*",
    "@keundal/task": "workspace:*",
    "@keundal/tsconfig": "workspace:*",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.13"
  }
}
