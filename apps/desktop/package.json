{
  "name": "@keundal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @keundal/web exec nuxt generate --envName desktop",
    "build:preview": "pnpm bundle",
    "bundle": "tauri build",
    "dev": "pnpm prepare:sidecar && tauri dev",
    "dev:ui": "pnpm --filter @keundal/web exec nuxt dev --envName desktop --no-open",
    "tauri": "tauri",
    "prepare:sidecar": "pnpm --filter @keundal/server build && node scripts/prepare-sidecar.mjs",
    "build:tauri": "pnpm prepare:sidecar && pnpm build"
  },
  "devDependencies": {
    "@keundal/server": "workspace:*",
    "@keundal/web": "workspace:*",
    "@tauri-apps/cli": "2.12.3"
  }
}
