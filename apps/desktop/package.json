{
  "name": "@keundal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:sidecar && pnpm --filter @keundal/web exec nuxt generate --envName desktop",
    "build:preview": "pnpm bundle",
    "bundle": "tauri build",
    "dev": "pnpm prepare:sidecar && tauri dev",
    "dev:ui": "pnpm --filter @keundal/web exec nuxt dev --envName desktop --no-open",
    "tauri": "tauri",
    "prepare:sidecar": "pnpm build:sidecar && node scripts/prepare-sidecar.mjs",
    "build:tauri": "pnpm exec turbo run build:sidecar build:desktop --filter=@keundal/desktop --filter=@keundal/web && node scripts/prepare-sidecar.mjs",
    "build:sidecar": "tsdown --config tsdown.sidecar.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@keundal/agent-host": "workspace:*",
    "@keundal/tsconfig": "workspace:*",
    "@keundal/web": "workspace:*",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
