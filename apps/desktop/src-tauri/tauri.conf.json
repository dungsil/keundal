{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keundal",
  "version": "0.1.0",
  "identifier": "com.keundal.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keundal",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "sidecar-info",
          "description": "Allow the local main window to obtain the sidecar connection information",
          "windows": ["main"],
          "permissions": ["allow-sidecar-info"]
        },
        {
          "identifier": "llm-settings",
          "description": "Allow the local main window to store LLM settings in the OS secret store",
          "windows": ["main"],
          "permissions": ["allow-load-llm-settings", "allow-save-llm-settings", "allow-load-mcp-settings", "allow-save-mcp-settings"]
        },
        {
          "identifier": "skill-files",
          "description": "Allow the local main window to read direct SKILL.md files in the fixed skill roots",
          "windows": ["main"],
          "permissions": ["allow-list-skill-files", "allow-read-skill-file"]
        },
        {
          "identifier": "runtime-plugins",
          "description": "Allow the local main window to manage optional Cordis plugins in app data",
          "windows": ["main"],
          "permissions": ["allow-runtime-plugins"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/keundal-host"],
    "resources": ["sidecar/**/*"]
  }
}
