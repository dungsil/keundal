{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "nursery": "warn"
  },
  "rules": {},
  "overrides": [
    {
      "files": [
        ".pnpmfile.cjs",
        "apps/**",
        "examples/**",
        "packages/*/tests/**",
        "packages/agent-host/src/**",
        "tools/lighthouse/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["packages/ui/nuxt.config.ts", "packages/chat-app/nuxt.config.ts", "apps/*/nuxt.config.ts"],
      "env": {
        "node": true
      },
      "globals": {
        "defineNuxtConfig": "readonly"
      }
    },
    {
      "files": ["packages/ui/app/**", "packages/chat-app/app/**", "apps/*/app/**"],
      "env": {
        "browser": true
      },
      "globals": {
        "computed": "readonly",
        "createError": "readonly",
        "defineAppConfig": "readonly",
        "defineNuxtPlugin": "readonly",
        "defineNuxtRouteMiddleware": "readonly",
        "navigateTo": "readonly",
        "nextTick": "readonly",
        "onBeforeRouteLeave": "readonly",
        "onBeforeUnmount": "readonly",
        "onMounted": "readonly",
        "onNuxtReady": "readonly",
        "onScopeDispose": "readonly",
        "onUnmounted": "readonly",
        "readonly": "readonly",
        "ref": "readonly",
        "refreshNuxtData": "readonly",
        "useAsyncData": "readonly",
        "useCookie": "readonly",
        "useHead": "readonly",
        "useId": "readonly",
        "useLocale": "readonly",
        "useNuxtApp": "readonly",
        "useNuxtData": "readonly",
        "useRequestHeaders": "readonly",
        "useRoute": "readonly",
        "useRuntimeConfig": "readonly",
        "useSeoMeta": "readonly",
        "useState": "readonly",
        "useTemplateRef": "readonly",
        "watch": "readonly"
      }
    },
    {
      "files": ["packages/chat-app/app/**"],
      "globals": {
        "defineMarkdownComponent": "readonly",
        "definePageMeta": "readonly",
        "defineShortcuts": "readonly",
        "getDomain": "readonly",
        "sourceToInlineMdc": "readonly",
        "useChatActions": "readonly",
        "useChatSettings": "readonly",
        "useChats": "readonly",
        "useColorMode": "readonly",
        "useDictation": "readonly",
        "useFileUpload": "readonly",
        "useFileUploadWithStatus": "readonly",
        "useKeundalChat": "readonly",
        "useLLMSettings": "readonly",
        "useModelCatalog": "readonly",
        "useModels": "readonly",
        "useOverlay": "readonly",
        "useStartupPending": "readonly",
        "useToast": "readonly"
      }
    },
    {
      "files": ["packages/ui/app/**/*.vue", "packages/chat-app/app/**/*.vue", "apps/*/app/**/*.vue"],
      "globals": {
        "defineEmits": "readonly",
        "defineModel": "readonly",
        "defineOptions": "readonly",
        "defineProps": "readonly",
        "withDefaults": "readonly"
      }
    },
    {
      "files": ["apps/web/server/**"],
      "globals": {
        "defineNitroPlugin": "readonly"
      }
    },
    {
      "files": [
        "packages/chat/src/**",
        "packages/plugin-chat-*/src/**",
        "packages/plugin-llm-browser/src/**",
        "packages/plugin-transcription-browser/src/**"
      ],
      "env": {
        "browser": true
      }
    }
  ]
}
